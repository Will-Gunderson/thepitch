---
import Base from '../layouts/Base.astro';
// Body is the Webflow export's markup, held verbatim in src/content/contact.html and
// injected with set:html. It is NOT inlined as Astro markup on purpose: Webflow nests
// <script class="w-json"> (lightbox config) inside <a class="w-lightbox">, and Astro's
// parser treats the <a> as an unclosed formatting element and reconstructs it around
// everything that follows — on amenities that turned 18 anchors into 157 and wrecked
// the DOM. set:html keeps the bytes as Webflow wrote them.
import body from '../content/contact.html?raw';
---
<Base title="Contact & Tours | The Pitch Apartments, St. Paul" description="Get in touch with the leasing team at The Pitch, 427 Snelling Ave N, St. Paul. Call (877) 660-3959 or schedule a private tour." wfPage="667dbf11e35cba7bb88787cf" current="contact">
  <Fragment set:html={body} />
</Base>
