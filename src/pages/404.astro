---
import Base from '../layouts/Base.astro';
// Body is the Webflow export's markup, held verbatim in src/content/404.html and
// injected with set:html. It is NOT inlined as Astro markup on purpose: Webflow nests
// <script class="w-json"> (lightbox config) inside <a class="w-lightbox">, and Astro's
// parser treats the <a> as an unclosed formatting element and reconstructs it around
// everything that follows — on amenities that turned 18 anchors into 157 and wrecked
// the DOM. set:html keeps the bytes as Webflow wrote them.
import body from '../content/404.html?raw';
---
<Base title="Page Not Found | The Pitch Apartments" wfPage="607734d2247298ccba7b01be" showPromo={false} showFooter={false} showNav={false} showBackToTop={false} noindex>
  <Fragment set:html={body} />
</Base>
