---
import Base from '../layouts/Base.astro';
// Body is the Webflow export's markup, held verbatim in src/content/gallery.html and
// injected with set:html. It is NOT inlined as Astro markup on purpose: Webflow nests
// <script class="w-json"> (lightbox config) inside <a class="w-lightbox">, and Astro's
// parser treats the <a> as an unclosed formatting element and reconstructs it around
// everything that follows — on amenities that turned 18 anchors into 157 and wrecked
// the DOM. set:html keeps the bytes as Webflow wrote them.
import body from '../content/gallery.html?raw';
---
<Base title="Photo Gallery | The Pitch Apartments, St. Paul" description="Photos of The Pitch in St. Paul — building exterior, interiors, amenity spaces and model apartments in the Midway neighborhood." wfPage="60ff876ab818e144b605ea57" current="gallery" backToTopFirst={false}>
  <Fragment set:html={body} />
</Base>
