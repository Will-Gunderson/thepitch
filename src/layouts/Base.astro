---
// Shared chrome for every page: head, promo bar, navbar, footer, scripts.
//
// The promo bar is the one editable thing on the site. Pages CMS writes
// public/content/promo.json (see .pages.yml) and commits it to main. That file is
// consumed twice on purpose:
//   1. here, at build time, so the served HTML already carries the current copy;
//   2. at runtime by /js/promo-content.js, which re-fetches it and overwrites the
//      markup, so an edit still lands even on an HTML response cached at the edge.
// Before the Astro conversion only (2) existed and the inline copy was a hand-kept
// duplicate that could drift. Keep both paths — dropping the fetch would make edits
// wait on a rebuild, dropping the build-time render would reintroduce the drift.
import promo from '../../public/content/promo.json';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  wfPage: string;              // Webflow's per-page id; thepitch.js keys interactions off it
  current?: 'home' | 'amenities' | 'floor-plans' | 'neighborhood' | 'gallery' | 'contact';
  navVariant?: 'overlay' | 'dark';
  showPromo?: boolean;
  showFooter?: boolean;
  showNav?: boolean;
  showBackToTop?: boolean;
  backToTopFirst?: boolean;   // export put it before the promo bar on some pages, after on others
  bodyClass?: string;         // only home carried class="body"
  ogImage?: string;           // absolute-from-root path; falls back to the exterior shot
  noindex?: boolean;          // 404 only — don't let it into the index
}
const {
  title,
  description,
  wfPage,
  current,
  navVariant = 'dark',
  showPromo = true,
  showFooter = true,
  showNav = true,
  showBackToTop = true,
  backToTopFirst = true,
  bodyClass = '',
  ogImage = '/images/211005AG_UrbanWorks_Pitch_003-p-1600.jpeg',
  noindex = false,
} = Astro.props;

// Canonical URL. `build.format: 'file'` means Astro.url can arrive as /amenities.html
// during the build while the host serves /amenities, so normalise both the extension
// and any trailing slash before resolving against `site` in astro.config.mjs.
const path =
  Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// One phone number, used for the tel: href, the visible text and the structured data.
// The export had these crossed — the navbar showed (651) 412-7725 but dialled
// +1 877 660 3959, and a second link showed (877) 660-3959 but dialled +1 651 447 4150.
// (877) 660-3959 is the number the footer states and links consistently, so it wins.
const PHONE_DISPLAY = '(877) 660-3959';
const PHONE_HREF = 'tel:+18776603959';

const navClass =
  navVariant === 'overlay'
    ? 'navbar-container overlay-hero sticky-top'
    : 'navbar-container bg-dark sticky-top';

// Webflow marks the active link with both aria-current and its own w--current class.
const NAV = [
  { key: 'amenities',    href: '/amenities',    label: 'Amenities' },
  { key: 'floor-plans',  href: '/floor-plans',  label: 'Availability' },
  { key: 'neighborhood', href: '/neighborhood', label: 'Neighborhood' },
  { key: 'gallery',      href: '/gallery',      label: 'Gallery' },
];
const isOn = (k: string) => current === k;
const dropdownHeadingHtml = String(promo.dropdown_heading ?? '')
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .replace(/\r?\n/g, '<br>');
---
<!DOCTYPE html>
<html data-wf-page={wfPage} data-wf-site="607734d2247298661c7b015a" lang="en">
<head>
  <meta charset="utf-8">
  <!-- Google Consent Mode v2 defaults (must run before Google tags load) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    (function(){
      var granted = false;
      try { granted = localStorage.getItem('pitch-cookie-consent') === 'granted'; } catch(e){}
      var v = granted ? 'granted' : 'denied';
      gtag('consent', 'default', {
        ad_storage: v, ad_user_data: v, ad_personalization: v, analytics_storage: v,
        functionality_storage: 'granted', security_storage: 'granted', wait_for_update: 500
      });
    })();
  </script>
  <title>{title}</title>
  <meta content="width=device-width, initial-scale=1" name="viewport">
  {description && <meta content={description} name="description">}
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex, follow">}

  <!-- Social cards. These used to live in index.astro's head slot, so every page but
       the homepage shared as a bare URL, and the large-image Twitter card had no image
       to show. Derived from the same title/description props so they can't drift. -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="The Pitch Apartments">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  {description && <meta property="og:description" content={description}>}
  <meta property="og:image" content={ogImageUrl}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  {description && <meta name="twitter:description" content={description}>}
  <meta name="twitter:image" content={ogImageUrl}>

  <!-- Start the handshakes for the third parties the page is certain to use, rather
       than waiting for the parser to reach their tags at the end of <body>. -->
  <link rel="preconnect" href="https://cdn.eliseai.com" crossorigin>
  <link rel="preconnect" href="https://www.googletagmanager.com">

  <slot name="head" />
  <link href="/css/normalize.css" rel="stylesheet" type="text/css">
  <link href="/css/components.css" rel="stylesheet" type="text/css">
  <link href="/css/thepitch.css" rel="stylesheet" type="text/css">
  <script is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
  <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon">
  <link href="/images/webclip.png" rel="apple-touch-icon">
  <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-C6SDM3FHL6"></script>
  <script is:inline>gtag('set', 'developer_id.dZGVlNj', true);gtag('js', new Date());gtag('config', 'G-C6SDM3FHL6');</script>
  <!--  Google Tag Manager  -->
  <!-- Restored: the Astro conversion dropped this loader but kept the <noscript>
       iframe at the end of <body>, so the container stopped loading for every
       JS-enabled visitor while still looking installed in the page source. -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-TQT627Q');</script>
  <!--  End Google Tag Manager  -->
  <!-- Structured data. Every field here is already stated in the footer as plain text;
       nothing is invented. Deliberately omitted: geo coordinates (not known here — a
       wrong one is worse than none) and Saturday's "by appointment only", which
       openingHoursSpecification can't express honestly. -->
  {!noindex && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ApartmentComplex',
      name: 'The Pitch Apartments',
      url: 'https://www.thepitchstp.com/',
      image: ogImageUrl,
      description:
        'Studio, alcove, one-bedroom and two-bedroom apartments in the Midway neighborhood of St. Paul, across from Allianz Field.',
      telephone: '+1-877-660-3959',
      email: 'management@pitchstpaul.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '427 Snelling Ave N',
        addressLocality: 'St. Paul',
        addressRegion: 'MN',
        postalCode: '55104',
        addressCountry: 'US',
      },
      openingHoursSpecification: [{
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '17:00',
      }],
      sameAs: [
        'https://www.facebook.com/thepitchstp',
        'https://www.instagram.com/thepitchstp/',
      ],
    })} />
  )}
  <style is:global>
body {
    -moz-osx-font-smoothing: grayscale;
    -webkit-font-smoothing: antialiased;
}
  </style>
</head>
<body class={bodyClass || undefined}>
  {showBackToTop && backToTopFirst && (
    <div id="Top" class="back-to-top-container">
      <div class="back-to-top-button">
        <a href="#Top" class="button icon-button bg-primary-1 w-inline-block"><img src="/images/icon-arrow-up.svg" alt="" class="button-icon-image"></a>
      </div>
    </div>
  )}

  {showPromo && promo.enabled !== false && (
    <div class="promo-bar">
      <div class="promo-bar-main">
        <div class="promo-headline"><strong>{promo.headline}</strong></div>
        <div class="promo-dropdown-svg w-embed"><svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="20" height="20" viewbox="0 0 50 50">
            <path fill="currentColor" d="M 25 2 C 12.308594 2 2 12.308594 2 25 C 2 37.691406 12.308594 48 25 48 C 37.691406 48 48 37.691406 48 25 C 48 12.308594 37.691406 2 25 2 Z M 25 4 C 36.609375 4 46 13.390625 46 25 C 46 36.609375 36.609375 46 25 46 C 13.390625 46 4 36.609375 4 25 C 4 13.390625 13.390625 4 25 4 Z M 14.90625 20.96875 C 14.863281 20.976563 14.820313 20.988281 14.78125 21 C 14.40625 21.066406 14.105469 21.339844 14 21.703125 C 13.894531 22.070313 14.003906 22.460938 14.28125 22.71875 L 24.28125 32.71875 C 24.46875 32.914063 24.730469 33.023438 25 33.023438 C 25.269531 33.023438 25.53125 32.914063 25.71875 32.71875 L 35.71875 22.71875 C 36.117188 22.320313 36.117188 21.679688 35.71875 21.28125 C 35.320313 20.882813 34.679688 20.882813 34.28125 21.28125 L 25 30.5625 L 15.71875 21.28125 C 15.511719 21.058594 15.210938 20.945313 14.90625 20.96875 Z"></path>
          </svg></div>
      </div>
      <div class="promo-bar-dropdown">
        <div class="left-promo">
          <div class="promo-info-wrapper">
            <div class="promo-info">
              <p class="paragraph-2"><strong set:html={dropdownHeadingHtml} /></p>
              <ul role="list" class="list">
                {promo.bullets.map((b: string) => <li class="list-item">{b}<br></li>)}
              </ul>
              <a href="#" eliseai="onOpenSST" class="button w-inline-block">
                <div class="text-block">{promo.cta_label}</div>
              </a>
            </div>
          </div>
        </div>
        <div class="right-promo">
          <div class="promo-info-wrapper">
            <div class="promo-image-wrapper"><img src="/images/211005AG_UrbanWorks_Pitch_15-p-800.jpeg" srcset="/images/211005AG_UrbanWorks_Pitch_15-p-500.jpeg 500w, /images/211005AG_UrbanWorks_Pitch_15-p-800.jpeg 800w, /images/211005AG_UrbanWorks_Pitch_15-p-1080.jpeg 1080w" sizes="(max-width: 767px) 90vw, 480px" width="1200" height="806" loading="lazy" decoding="async" alt="" class="image-100"></div>
          </div>
        </div>
        <div class="close-promo-wrapper">
          <div class="promo-close-svg w-embed"><svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" viewbox="0 0 30 30">
              <path fill="currentColor" d="M15,3C8.373,3,3,8.373,3,15c0,6.627,5.373,12,12,12s12-5.373,12-12C27,8.373,21.627,3,15,3z M19.707,18.293 c0.391,0.391,0.391,1.023,0,1.414C19.512,19.902,19.256,20,19,20s-0.512-0.098-0.707-0.293L15,16.414l-3.293,3.293 C11.512,19.902,11.256,20,11,20s-0.512-0.098-0.707-0.293c-0.391-0.391-0.391-1.023,0-1.414L13.586,15l-3.293-3.293 c-0.391-0.391-0.391-1.023,0-1.414s1.023-0.391,1.414,0L15,13.586l3.293-3.293c0.391-0.391,1.023-0.391,1.414,0s0.391,1.023,0,1.414 L16.414,15L19.707,18.293z"></path>
            </svg></div>
        </div>
      </div>
    </div>
  )}

  {showBackToTop && !backToTopFirst && (
    <div id="Top" class="back-to-top-container">
      <div class="back-to-top-button">
        <a href="#Top" class="button icon-button bg-primary-1 w-inline-block"><img src="/images/icon-arrow-up.svg" alt="" class="button-icon-image"></a>
      </div>
    </div>
  )}

  {showNav && (
  <div class={navClass}>
    {navVariant === 'overlay' && <div class="navbar-bg"></div>}
    <div class="main-container">
      <div data-collapse="medium" data-animation="default" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="navbar w-nav">
        <a href={PHONE_HREF} class="phone-bar w-inline-block">
          <div class="text-block-19">call us at {PHONE_DISPLAY}</div>
        </a>
        <div class="navbar-grid">
          <nav role="navigation" id="w-node-a601d530-7792-e715-2d54-671fa22a644f-a22a644b" class="nav-menu no-left-margin w-nav-menu">
            {NAV.map((n) => (
              <a href={n.href}
                 aria-current={isOn(n.key) ? 'page' : undefined}
                 class={`nav-link text-white w-nav-link${isOn(n.key) ? ' w--current' : ''}`}>{n.label}</a>
            ))}
          </nav>
          <a href="/" id="w-node-a601d530-7792-e715-2d54-671fa22a644d-a22a644b"
             aria-current={current === 'home' ? 'page' : undefined}
             class={`navbar-brand w-nav-brand${current === 'home' ? ' w--current' : ''}`}><img src="/images/ThePitch-Logo.svg" width="171" alt="" class="round-logo"></a>
          <nav role="navigation" class="nav-menu-phone no-left-margin w-nav-menu">
            {NAV.map((n) => (
              <a href={n.href}
                 aria-current={isOn(n.key) ? 'page' : undefined}
                 class={`mobile-nav w-nav-link${isOn(n.key) ? ' w--current' : ''}`}>{n.label}</a>
            ))}
            <a href="https://pitchstpaul.prospectportal.com/Apartments/module/application_authentication/" class="mobile-nav w-nav-link">Apply</a>
            <a href="https://pitchstpaul.residentportal.com/auth" class="mobile-nav w-nav-link">Residents</a>
            <a href="/contact"
               aria-current={current === 'contact' ? 'page' : undefined}
               class={`mobile-nav w-nav-link${current === 'contact' ? ' w--current' : ''}`}>Contact</a>
          </nav>
          <div id="w-node-a601d530-7792-e715-2d54-671fa22a648e-a22a644b" class="navbar-right-content-wrapper">
            <a href="https://pitchstpaul.prospectportal.com/Apartments/module/application_authentication/" target="_blank" class="nav-link text-white w-nav-link">Apply Now</a>
            <a href="https://pitchstpaul.residentportal.com/auth" target="_blank" class="nav-link text-white right w-nav-link">Residents</a>
            <a eliseai="onOpenEmailUsWindow" href="#" class="nav-link text-white right w-nav-link">Contact</a>
            <div class="navbar-right-content">
              <div class="navbar-right-item">
                <a href={PHONE_HREF} class="underline-link w-inline-block">
                  <div class="small-text text-white">{PHONE_DISPLAY}</div>
                  <div class="underline-container bg-white">
                    <div class="underline-line bg-white"></div>
                  </div>
                </a>
              </div>
              <a href="/?doorway=contact" class="button small outline-white hide w-inline-block">
                <div class="text-block-6">Contact Us</div>
              </a>
            </div>
            <div class="menu-button w-nav-button"><img src="/images/icon-menu_1.svg" alt=""></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  )}

  <slot />

  {showFooter && <Footer />}

  <!-- The export's search modal is gone. Nothing in the markup could open it — no
       button, no icon, and images/icon-search.svg was unreferenced — and its form
       posted to /search, which has never existed on this site. It was dead markup on
       six of eight pages, so the block and its `showSearchModal` prop are removed. -->

  <!-- Self-hosted, byte-identical to what Webflow's CloudFront served (verified against
       the integrity hash the export shipped). Same file, one fewer origin to resolve and
       shake hands with, and it now inherits the long cache TTL from public/_headers. -->
  <script is:inline src="/js/jquery-3.5.1.min.js" type="text/javascript"></script>
  <script is:inline src="/js/thepitch.js" type="text/javascript"></script>
  <!--  MeetElise Chat + AI Buttons  -->
  <script type="module" is:inline>
  import Chat from 'https://cdn.eliseai.com/@meetelise/chat';
  // Start MeetElise chat:
  Chat.start({
    organization: '32694095-7227-4a41-9d84-187e71bdb1e6'
  });
  // Wire up eliseAI buttons after the DOM is ready
  document.addEventListener('DOMContentLoaded', function() {
    // For [eliseAI="onOpenSST"]
    document.querySelectorAll('[eliseAI="onOpenSST"]').forEach(function(element) {
      element.addEventListener('click', function() {
        if (window.eliseAi && typeof window.eliseAi.onOpenSST === 'function') {
          window.eliseAi.onOpenSST();
        }
      });
    });
    // For [eliseAI="onOpenEmailUsWindow"]
    document.querySelectorAll('[eliseAI="onOpenEmailUsWindow"]').forEach(function(element) {
      element.addEventListener('click', function() {
        if (window.eliseAi && typeof window.eliseAi.onOpenEmailUsWindow === 'function') {
          window.eliseAi.onOpenEmailUsWindow();
        }
      });
    });
  });
</script>
  <!--  Google Tag Manager (noscript)  -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5MW9Q9P" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!--  End Google Tag Manager (noscript)  -->
  <!--  Google Tag Manager (noscript)  -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TQT627Q" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!--  End Google Tag Manager (noscript)  -->
  <script is:inline src="/js/promo-content.js"></script>
  <script is:inline src="/js/promo-bar.js"></script>
  <script is:inline src="/js/cookie-consent.js"></script>
</body>
</html>
